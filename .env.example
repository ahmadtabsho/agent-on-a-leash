# Hosted sandbox API (verified live; /healthz needs no key)
LEASH_BASE_URL=https://saw26api.ashyground-364e1d07.switzerlandnorth.azurecontainerapps.io

# Team bearer key, handed out on event day. Required by every endpoint except /healthz.
TEAM_API_KEY=

# Decision budget. Platform default deadline is 8s from queueing; we answer well inside it.
LEASH_DECISION_BUDGET_MS=2500

# Optional LLM assist for fuzzy intent matching and clarification wording.
# The deterministic engine ALWAYS produces a decision on its own if this is unset or fails.
LEASH_LLM_ENABLED=true
LEASH_LLM_MODEL=google/gemini-2.5-flash-lite
LEASH_LLM_TIMEOUT_MS=1200
OPENROUTER_API_KEY=
