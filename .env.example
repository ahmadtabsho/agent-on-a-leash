# Hosted sandbox API (verified live; /healthz needs no key)
LEASH_BASE_URL=https://saw26api.ashyground-364e1d07.switzerlandnorth.azurecontainerapps.io

# Team bearer key, handed out on event day. Required by every endpoint except /healthz.
TEAM_API_KEY=

# Decision budget. Platform default deadline is 8s from queueing; we answer well inside it.
LEASH_DECISION_BUDGET_MS=2500

# How long the customer has to answer a paused purchase. Only ever SHORTENS the
# platform's own window, for demonstration. Leave unset to use the real 120s.
# LEASH_HUMAN_TIMEOUT_SECONDS=25

# Optional second opinion on one question: is this cart line the item the
# customer described? It never sees the policy and can only raise doubt, never
# grant permission. The deterministic engine produces the same decisions with
# this off, unreachable, or broken.
LEASH_LLM_ENABLED=false
# A real round trip to a hosted model costs ~800 ms. 2000 leaves the
# 8-second decision deadline six seconds of headroom.
LEASH_LLM_TIMEOUT_MS=2000

# Pick one provider. Each needs only its own key.
LEASH_LLM_PROVIDER=openrouter
LEASH_LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=

# LEASH_LLM_PROVIDER=openai
# LEASH_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# LEASH_LLM_PROVIDER=anthropic
# LEASH_LLM_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
